# Пример конфигурации для docker compose
# Скопируйте в .env и заполните значения

# ================== ОБЯЗАТЕЛЬНЫЕ ДЛЯ PROD ==================

# База данных
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password

# JWT (минимум 32 символа для безопасности)
JWT_SECRET=your_very_secure_jwt_secret_key_min_32_chars
JWT_EXPIRATION=3600000

# Email (Gmail) - для PROD
EMAIL_ADDRESS=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# ================== ОПЦИОНАЛЬНО ДЛЯ LOCAL ==================
# Для локальной разработки можно не указывать - есть значения по умолчанию
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# JWT_SECRET=local_dev_secret_key_min_32_characters_long
# JWT_EXPIRATION=3600000
# EMAIL_ADDRESS=test@localhost
